# =============================================================================
# CleanSlate API - environment template
# Copy to backend/.env for local runs. Never commit a real .env file.
# All values are optional in development; production refuses to boot without a
# CORS allowlist (see ALLOWED_ORIGINS).
# =============================================================================

# "development" or "production". Production enables strict checks and HSTS.
ENVIRONMENT=development

# Comma-separated exact origins of the frontend, e.g.
#   https://cleanslate.pages.dev,https://cleanslate.example.pages.dev
# Exact match only - wildcards are rejected. CORS is a browser policy, not
# authentication: the API is public by design and rate limited instead.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- Limits ---------------------------------------------------------------
# Maximum accepted upload size in bytes (default 25 MiB = 26214400).
MAX_UPLOAD_BYTES=26214400
# Extra margin over MAX_UPLOAD_BYTES for multipart overhead (default = upload+1 MiB).
MAX_REQUEST_BYTES=27262976
# Hard cap on concurrent in-flight jobs held by this process.
MAX_CONCURRENT_JOBS=6
# Hard cap on total bytes of job scratch data held by this process.
MAX_TEMP_BYTES=134217728

# ---- Timeouts -------------------------------------------------------------
EXIFTOOL_TIMEOUT_SECONDS=20
QPDF_TIMEOUT_SECONDS=20
# Overall HTTP request budget for a processing request.
REQUEST_TIMEOUT_SECONDS=45

# ---- Retention (privacy) --------------------------------------------------
# How long a sanitized copy may live on disk before the sweeper deletes it.
JOB_TTL_SECONDS=300
# How long a single-use download token stays valid.
DOWNLOAD_TOKEN_TTL_SECONDS=300
# Bind download tokens to the requesting client IP (recommended).
DOWNLOAD_BIND_IP=true
# Interval of the background cleanup sweeper.
CLEANUP_INTERVAL_SECONDS=15

# ---- Rate limiting (per client IP, per process) ---------------------------
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Security -------------------------------------------------------------
# Only enable when the app really sits behind a trusted reverse proxy that sets
# X-Forwarded-For. Off by default so clients cannot spoof their own IP.
TRUST_PROXY_HEADERS=false
# Send Strict-Transport-Security (enable in production HTTPS deployments).
ENABLE_HSTS=true
# Expose /docs and /openapi.json. Keep false in production.
EXPOSE_API_DOCS=false
# Secret used for HMACed IP hashes and job identifiers. Set a random 32+ byte
# value in production so hashes are stable across restarts and instances.
SECRET_KEY=
# Optional absolute paths to the tools; defaults resolve from PATH.
EXIFTOOL_PATH=exiftool
QPDF_PATH=qpdf
# Scratch root for per-job directories (created automatically).
TEMP_ROOT=
