# =============================================================================
# CleanSlate frontend - environment template
# Copy to frontend/.env (local) or set the same keys in the Cloudflare Pages
# build settings. Vite only exposes variables prefixed with VITE_.
# =============================================================================

# Absolute HTTPS origin + base path of the deployed CleanSlate API.
# Production example: https://cleanslate-api.onrender.com
# Leave EMPTY for local development: vite then proxies /api to http://127.0.0.1:8787.
# This value is also baked into the Content-Security-Policy connect-src directive
# and into public/_headers, so it must be the exact API origin (no wildcards,
# no trailing slash).
VITE_API_BASE_URL=

# Optional: where the vite dev proxy should forward /api (default 127.0.0.1:8787).
# Only used when VITE_API_BASE_URL is empty.
DEV_API_TARGET=http://127.0.0.1:8787
